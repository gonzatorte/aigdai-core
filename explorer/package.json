{
  "name": "graph-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@react-input/mask": "^2.0.4",
    "d3": "^7.9.0",
    "d3-force": "^3.0.0",
    "immutable": "^5.1.3",
    "lodash": "^4.17.21",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "bun run dev.js",
    "build": "node build.js",
    "start": "bun run dev",
    "serve:dev": "live-server dist --port=3000 --no-browser",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"src/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"src/*.{ts,tsx,css,json}\"",
    "precommit": "npm run format && npm run lint:fix && npm run type-check && npm run build"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/immutable": "^3.8.7",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "dotenv": "^17.2.1",
    "esbuild": "^0.25.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "live-server": "^1.2.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
