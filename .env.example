# Copiar a .env y completar. El archivo .env no se versiona.
# Lo leen tanto los scripts de Python (settings.py) como docker compose.

# --- MongoDB ---
# docker compose crea el usuario con estos valores; los scripts arman MONGO_URL con ellos.
MONGO_USER=aigdai-user
MONGO_PASSWORD=
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=aigdai
# Alternativa: definir la URL completa y omitir las variables anteriores.
# MONGO_URL=mongodb://usuario:clave@localhost:27017/aigdai?authSource=admin

# --- Jena / Fuseki ---
JENA_BASE_PATH=http://localhost:3030/
JENA_DATASET=aigdai
# Contraseña del usuario admin de Fuseki (la usa docker-compose-jena.yml).
FUSEKI_ADMIN_PASSWORD=

# --- FAIRsharing ---
# Credenciales de la cuenta usada por el extractor.
FAIRSHARING_USERNAME=
FAIRSHARING_PASSWORD=

# --- Otros ---
JAVA_EXE_PATH=/usr/bin/java
