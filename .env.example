# Copy to .env and fill in. The .env file is not versioned.
# It is read both by the Python scripts (settings.py) and by docker compose.

# --- MongoDB ---
# docker compose creates the user with these values; the scripts build MONGO_URL from them.
MONGO_USER=aigdai-user
MONGO_PASSWORD=
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=aigdai
# Alternative: define the full URL and omit the variables above.
# MONGO_URL=mongodb://user:password@localhost:27017/aigdai?authSource=admin

# --- Jena / Fuseki ---
JENA_BASE_PATH=http://localhost:3030/
JENA_DATASET=aigdai
# Password of the Fuseki admin user (used by docker-compose-jena.yml).
FUSEKI_ADMIN_PASSWORD=

# --- FAIRsharing ---
# Credentials of the account used by the extractor.
FAIRSHARING_USERNAME=
FAIRSHARING_PASSWORD=

# --- Other ---
JAVA_EXE_PATH=/usr/bin/java
