PREFIX dai: <http://aigdai.tbox.owl/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?repo ?agregador
WHERE {
  # DFG 201: Basic Biological and Medical Research
  # Subdisciplines in any taxonomy: every step goes to an equal or broader discipline. closeMatch and relatedMatch
  # are left out because, chained, they drift to unrelated fields (see tech-debt.md, [dfg-fos]).
  ?disciplina (dai:es_sub_disciplina_de|skos:broadMatch|skos:exactMatch|^skos:exactMatch|^skos:narrowMatch)* <http://aigdai.tbox.owl/disciplina/201> .
  ?agregador dai:repositorio_afin_a_disciplina ?disciplina .
  # Direct harvesting only: FAIRsharing records that are both knowledgebase and repository are stated in both
  # directions, and the transitive path through those cycles would relate almost every repository to every aggregator
  ?repo dai:repositorio_es_cosechado_por_agregador ?agregador .
}
ORDER BY ?repo
