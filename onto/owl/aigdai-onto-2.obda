[PrefixDeclaration]
:		http://test.org
owl:		http://www.w3.org/2002/07/owl#
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
xml:		http://www.w3.org/XML/1998/namespace
xsd:		http://www.w3.org/2001/XMLSchema#
obda:		https://w3id.org/obda/vocabulary#
rdfs:		http://www.w3.org/2000/01/rdf-schema#

[MappingDeclaration] @collection [[
mappingId	attrs-repositorio
target		:#repositorio/{id} a :#repositorio ; :#tiene_nombre_repositorio {nombre} . 
source		SELECT id, nombre FROM "repositorio";

mappingId	disciplina
target		:#disciplina/{id} a :#disciplina . 
source		SELECT id FROM disciplina;

mappingId	subdisciplinas
target		:#disciplina/{id} :#es_sub_disciplina_de :#disciplina/{super_id} . 
source		SELECT id, super_id  FROM "disciplina" WHERE super_id IS NOT NULL;

mappingId	repos y disciplinas
target		:#repositorio/{repositorio_id} :#repositorio_afin_a_disciplina :#disciplina/{disciplina_id} . 
source		SELECT disciplina_id, repositorio_id FROM repositorio_m2m_disciplina;
]]

