    <!-- Cotas derivadas de estadistico_generado_en_fecha (gross_date/date): permiten comparar fechas de granularidad variable en SPARQL -->
    <Declaration>
        <DataProperty IRI="estadistico_generado_en_fecha_desde"/>
    </Declaration>
