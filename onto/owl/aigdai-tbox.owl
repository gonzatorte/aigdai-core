    </AnnotationAssertion>

    <Declaration>
        <Class IRI="repositorio_de_articulos_de_investigacion"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="repositorio_de_articulos_de_investigacion"/>
        <Class IRI="repositorio_de_investigacion"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio_de_articulos_de_investigacion</IRI>
        <Literal xml:lang="en">research papers repository</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio_de_articulos_de_investigacion</IRI>
        <Literal xml:lang="es">repositorio de artículos</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio_de_articulos_de_investigacion</IRI>
        <Literal xml:lang="es">repositorio de publicaciones</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio_de_articulos_de_investigacion</IRI>
        <Literal xml:lang="en">publication repository</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_de_articulos_de_investigacion</IRI>
        <Literal xml:lang="es">Repositorio de investigación especializado en gestionar datos y metadatos de publicaciones científicas. Suele priorizar la indexación de texto, las referencias cruzadas entre artículos, los índices cienciométricos y el soporte al proceso editorial. Su gestión está más difundida que la de datos, especialmente en América Latina. Ejemplo: arXiv.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_de_articulos_de_investigacion</IRI>
        <Literal xml:lang="en">Research repository specialized in managing data and metadata of scientific publications. It usually prioritizes text indexing, cross-references between articles, scientometric indices and support for the editorial process. Its management is more widespread than data management, especially in Latin America. Example: arXiv.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <Class IRI="rdd"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="rdd"/>
        <Class IRI="repositorio_de_investigacion"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>rdd</IRI>
        <Literal xml:lang="en">research data repository</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>rdd</IRI>
        <Literal xml:lang="es">repositorio de datos de investigación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>rdd</IRI>
        <Literal xml:lang="es">RDD</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>rdd</IRI>
        <Literal xml:lang="en">RDR</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>rdd</IRI>
        <Literal xml:lang="es">repositorio de datos abiertos de investigación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>rdd</IRI>
        <Literal xml:lang="es">Repositorio de investigación especializado en colecciones de datos de investigación. Según re3data, es una infraestructura de información sostenible que proporciona almacenamiento y acceso a largo plazo a datos que son la base de publicaciones académicas. Los datos, a diferencia de los artículos, tienen formatos y estructuras muy diversas, lo que condiciona su curaduría y preservación. Es el objeto de estudio central de la ontología: sus variables de calidad (FAIR, TRUST, certificaciones) apoyan la selección del repositorio adecuado para depositar datos. Ejemplos: Zenodo, Harvard Dataverse.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>rdd</IRI>
        <Literal xml:lang="en">Research repository specialized in research datasets. According to re3data, it is a sustainable information infrastructure providing long-term storage and access to data underlying scholarly publications. Unlike articles, data comes in very diverse formats and structures, which conditions its curation and preservation. It is the central object of study of the ontology: its quality variables (FAIR, TRUST, certifications) support choosing the right repository to deposit data. Examples: Zenodo, Harvard Dataverse.</Literal>
    </AnnotationAssertion>

    <!-- ToDo: Populate with the levels defined in https://zenodo.org/records/11476980 -->
    <Declaration>
        <DataProperty IRI="nivel_de_curaduria"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="nivel_de_curaduria"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>nivel_de_curaduria</IRI>
        <Literal xml:lang="en">curation level</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>nivel_de_curaduria</IRI>
        <Literal xml:lang="es">nivel de curaduría</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:basado_en"/>
        <IRI>nivel_de_curaduria</IRI>
        <Literal>http://doi.org/10.2312/re3.006</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:basado_en"/>
        <IRI>nivel_de_curaduria</IRI>
        <Literal>https://doi.org/10.15497/RDA00103</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>nivel_de_curaduria</IRI>
        <Literal xml:lang="es">nivel de curación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>nivel_de_curaduria</IRI>
        <Literal xml:lang="en">curation level of service</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>nivel_de_curaduria</IRI>
        <Literal xml:lang="es">Grado de revisión y mejora que el repositorio aplica sobre los datos y metadatos depositados, desde la aceptación sin revisión hasta la curaduría experta de datos. Los niveles se ordenan mediante nivel_de_curaduria_es_mayor_a y se basan en re3data y en los niveles de curaduría de la RDA/CoreTrustSeal.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>nivel_de_curaduria</IRI>
        <Literal xml:lang="en">Degree of review and enhancement the repository applies to deposited data and metadata, from acceptance without review to expert data-level curation. Levels are ordered through nivel_de_curaduria_es_mayor_a and are based on re3data and on the RDA/CoreTrustSeal curation levels.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <ObjectProperty IRI="nivel_de_curaduria_es_mayor_a"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>nivel_de_curaduria_es_mayor_a</IRI>
        <Literal xml:lang="es">nivel de curaduría es mayor a</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>nivel_de_curaduria_es_mayor_a</IRI>
        <Literal xml:lang="en">curation level is higher than</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>nivel_de_curaduria_es_mayor_a</IRI>
        <Literal xml:lang="es">Orden entre niveles de curaduría: indica que un nivel implica una curaduría más exhaustiva que otro.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>nivel_de_curaduria_es_mayor_a</IRI>
        <Literal xml:lang="en">Order between curation levels: states that one level implies a more thorough curation than another.</Literal>
    </AnnotationAssertion>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="nivel_de_curaduria_es_mayor_a"/>
        <Class IRI="nivel_de_curaduria"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="nivel_de_curaduria_es_mayor_a"/>
        <Class IRI="nivel_de_curaduria"/>
    </ObjectPropertyRange>
    <TransitiveObjectProperty>
        <ObjectProperty IRI="nivel_de_curaduria_es_mayor_a"/>
    </TransitiveObjectProperty>

    <Declaration>
        <ObjectProperty IRI="repositorio_acepta_tipo_de_contenido"/>
    </Declaration>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="repositorio_acepta_tipo_de_contenido"/>
        <Class IRI="rdd"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="repositorio_acepta_tipo_de_contenido"/>
        <!-- ToDo: Point to tipo_de_dato or to a new schema?
        In re3data, it corresponds to the data specified by COAR: http://purl.org/coar/resource_type/c_ddb1 .
        See how autodiscovery and linking with other standards are done from what is declared there (I think they use SKOS) -->
        <Class IRI="tipo_de_dato"/>
    </ObjectPropertyRange>
    <SubObjectPropertyOf>
        <ObjectPropertyChain>
            <ObjectProperty IRI="repositorio_acepta_tipo_de_contenido"/>
            <ObjectProperty abbreviatedIRI="skos:broaderTransitive"/>
        </ObjectPropertyChain>
        <ObjectProperty IRI="repositorio_acepta_tipo_de_contenido"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
        <ObjectPropertyChain>
            <ObjectProperty IRI="repositorio_acepta_tipo_de_contenido"/>
            <ObjectProperty abbreviatedIRI="skos:broadMatch"/>
        </ObjectPropertyChain>
        <ObjectProperty IRI="repositorio_acepta_tipo_de_contenido"/>
    </SubObjectPropertyOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio_acepta_tipo_de_contenido</IRI>
        <Literal xml:lang="en">research data repository accepts type of content</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio_acepta_tipo_de_contenido</IRI>
        <Literal xml:lang="es">repositorio de datos de investigación acepta tipo de contenido</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_acepta_tipo_de_contenido</IRI>
        <Literal xml:lang="en">All types of resources available in the RDR</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_acepta_tipo_de_contenido</IRI>
        <Literal xml:lang="es">Todos los tipos de recursos disponibles en el repositorio de datos de investigación, según el vocabulario de tipos de recurso de COAR.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <Class IRI="catalogo_de_repositorios"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="catalogo_de_repositorios"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>catalogo_de_repositorios</IRI>
        <Literal xml:lang="es">catálogo de repositorios</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>catalogo_de_repositorios</IRI>
        <Literal xml:lang="en">repository catalog</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>catalogo_de_repositorios</IRI>
        <Literal xml:lang="es">registro de repositorios</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>catalogo_de_repositorios</IRI>
        <Literal xml:lang="es">directorio de repositorios</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>catalogo_de_repositorios</IRI>
        <Literal xml:lang="en">repository registry</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>catalogo_de_repositorios</IRI>
        <Literal xml:lang="en">repository directory</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>catalogo_de_repositorios</IRI>
        <Literal xml:lang="es">Sistema encargado de catalogar (listar, ordenar, clasificar y caracterizar) repositorios. Aunque otros modelos lo tratan como un repositorio de objetos semánticos, aquí se modela por separado porque permite registrar la procedencia de los metadatos de cada repositorio y qué catálogos intercambian información entre sí. Ejemplos: re3data, FAIRsharing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>catalogo_de_repositorios</IRI>
        <Literal xml:lang="en">System in charge of cataloging (listing, sorting, classifying and characterizing) repositories. Although other models treat it as a repository of semantic objects, here it is modeled separately because it records the provenance of each repository's metadata and which catalogs exchange information with each other. Examples: re3data, FAIRsharing.</Literal>
    </AnnotationAssertion>
    <Declaration>
        <Class IRI="id_de_repositorio"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="id_de_repositorio"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>id_de_repositorio</IRI>
        <Literal xml:lang="es">identificador de repositorio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>id_de_repositorio</IRI>
        <Literal xml:lang="en">repository identifier</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>id_de_repositorio</IRI>
        <Literal xml:lang="es">Identificador que un catálogo de repositorios asigna a un repositorio (p. ej. un ID de re3data). Sirve para reconciliar los registros de un mismo repositorio provenientes de distintas fuentes, conservando su procedencia.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>id_de_repositorio</IRI>
        <Literal xml:lang="en">Identifier that a repository catalog assigns to a repository (e.g. a re3data ID). It is used to reconcile records of the same repository coming from different sources while keeping their provenance.</Literal>
    </AnnotationAssertion>
    <Declaration>
        <ObjectProperty IRI="id_de_repositorio_tiene_catalogo"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>id_de_repositorio_tiene_catalogo</IRI>
        <Literal xml:lang="es">identificador de repositorio tiene catálogo</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>id_de_repositorio_tiene_catalogo</IRI>
        <Literal xml:lang="en">repository identifier has catalog</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>id_de_repositorio_tiene_catalogo</IRI>
        <Literal xml:lang="es">Relaciona un identificador de repositorio con el catálogo que lo emitió.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>id_de_repositorio_tiene_catalogo</IRI>
        <Literal xml:lang="en">Links a repository identifier to the catalog that issued it.</Literal>
    </AnnotationAssertion>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="id_de_repositorio_tiene_catalogo"/>
        <Class IRI="id_de_repositorio"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="id_de_repositorio_tiene_catalogo"/>
        <Class IRI="catalogo_de_repositorios"/>
    </ObjectPropertyRange>
    <FunctionalObjectProperty>
        <ObjectProperty IRI="id_de_repositorio_tiene_catalogo"/>
    </FunctionalObjectProperty>
    <Declaration>
        <ObjectProperty IRI="id_de_repositorio_tiene_repositorio"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>id_de_repositorio_tiene_repositorio</IRI>
        <Literal xml:lang="es">identificador de repositorio tiene repositorio</Literal>
    </AnnotationAssertion>
