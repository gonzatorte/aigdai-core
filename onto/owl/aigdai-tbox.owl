    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>tipo_de_organizacion</IRI>
        <Literal xml:lang="es">Enumerado de los tipos de organización, basado principalmente en los tipos de ROR (p. ej. educación, gobierno, financiador) y complementado con valores declarados por re3data (comercial, no comercial).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>tipo_de_organizacion</IRI>
        <Literal xml:lang="en">Enumeration of organization types, mainly based on ROR types (e.g. education, government, funder) and complemented with values declared by re3data (commercial, non-commercial).</Literal>
    </AnnotationAssertion>
    <DatatypeDefinition>
        <Datatype IRI="tipo_de_organizacion"/>
        <DataOneOf>
            <Literal>archive</Literal>
            <Literal>comercial</Literal>
            <Literal>company</Literal>
            <Literal>education</Literal>
            <Literal>facility</Literal>
            <Literal>funder</Literal>
            <Literal>government</Literal>
            <Literal>healthcare</Literal>
            <Literal>no-comercial</Literal>
            <Literal>nonprofit</Literal>
            <Literal>consortium</Literal>
            <Literal>publisher</Literal>
            <Literal>other</Literal>
        </DataOneOf>
    </DatatypeDefinition>
