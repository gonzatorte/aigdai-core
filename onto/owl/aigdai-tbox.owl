    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>nivel_de_apertura_para_escritura</IRI>
        <Literal xml:lang="es">Nivel de apertura del repositorio para el depósito de datos: abierto (cualquiera puede depositar), restringido (p. ej. solo miembros de una institución o previa registración) o cerrado.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>nivel_de_apertura_para_escritura</IRI>
        <Literal xml:lang="en">Openness level of the repository for data deposit: open (anyone can deposit), restricted (e.g. only members of an institution or after registration) or closed.</Literal>
    </AnnotationAssertion>
