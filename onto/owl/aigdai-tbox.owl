    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>locacion</IRI>
        <Literal xml:lang="es">ubicación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
