        <IRI>locacion</IRI>
        <Literal xml:lang="es">región</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>locacion</IRI>
