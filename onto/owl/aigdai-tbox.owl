        <IRI>repositorio_afin_a_disciplina</IRI>
        <Literal xml:lang="es">Relaciona un repositorio con una disciplina a la que está orientado o cuyos datos aloja. Permite identificar repositorios disciplinarios frente a generalistas.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
