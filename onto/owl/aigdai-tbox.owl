        <Class IRI="esquema_de_id_persistente"/>
        <Class IRI="estandar"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>esquema_de_id_persistente</IRI>
        <Literal xml:lang="es">esquema de identificador persistente</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>esquema_de_id_persistente</IRI>
        <Literal xml:lang="en">persistent identifier schema</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>esquema_de_id_persistente</IRI>
        <Literal xml:lang="es">tipo de identificador persistente</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>esquema_de_id_persistente</IRI>
