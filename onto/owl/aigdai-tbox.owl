        <Class IRI="resultado_de_investigacion"/>
    </ObjectPropertyRange>
    <Declaration>
        <Class IRI="id_de_resultado_de_investigacion"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>id_de_resultado_de_investigacion</IRI>
        <Literal xml:lang="es">identificador de resultado de investigación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>id_de_resultado_de_investigacion</IRI>
        <Literal xml:lang="en">research output identifier</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>id_de_resultado_de_investigacion</IRI>
        <Literal xml:lang="es">identificador persistente</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>id_de_resultado_de_investigacion</IRI>
        <Literal xml:lang="en">PID</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>id_de_resultado_de_investigacion</IRI>
        <Literal xml:lang="es">Identificador de un resultado de investigación bajo un esquema de identificadores persistentes (p. ej. un DOI concreto). Su carácter global permite que toda la comunidad lo reconozca, y su persistencia garantiza la trazabilidad del resultado aunque cambie su ubicación.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>id_de_resultado_de_investigacion</IRI>
        <Literal xml:lang="en">Identifier of a research output under a persistent identifier scheme (e.g. a specific DOI). Being global lets the whole community recognize it, and being persistent guarantees the traceability of the output even if its location changes.</Literal>
    </AnnotationAssertion>
    <SubClassOf>
        <Class IRI="id_de_resultado_de_investigacion"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <Declaration>
