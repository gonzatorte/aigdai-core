    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>estadistico</IRI>
        <Literal xml:lang="es">estadístico</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>estadistico</IRI>
        <Literal xml:lang="en">statistics</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>estadistico</IRI>
        <Literal xml:lang="es">facetado</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>estadistico</IRI>
        <Literal xml:lang="es">métrica de contenido</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>estadistico</IRI>
        <Literal xml:lang="en">facet</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>estadistico</IRI>
        <Literal xml:lang="en">statistic</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>estadistico</IRI>
        <Literal xml:lang="es">Resumen cuantitativo de los contenidos alojados en un repositorio: cantidad de resultados de investigación que cumplen un criterio (disciplina, licencia, afiliación, tipo de dato, fecha de publicación) respecto del total, en una fecha dada. Permite perfilar al repositorio a partir de sus contenidos sin extraer cada colección, y mantener la trazabilidad del cálculo. Se obtiene principalmente de los facetados de DataCite. No debe tomarse como indicador absoluto de calidad.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>estadistico</IRI>
        <Literal xml:lang="en">Quantitative summary of the contents hosted by a repository: number of research outputs matching a criterion (discipline, license, affiliation, data type, publication date) relative to the total, at a given date. It allows profiling the repository from its contents without extracting every dataset, while keeping the computation traceable. It is obtained mainly from DataCite facets. It should not be taken as an absolute quality indicator.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <DataProperty IRI="estadistico_generado_en_fecha"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>estadistico_generado_en_fecha</IRI>
        <Literal xml:lang="es">estadístico generado en fecha</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
