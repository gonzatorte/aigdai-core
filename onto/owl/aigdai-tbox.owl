    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>formato_de_exportacion_de_citas</IRI>
        <Literal xml:lang="es">formato de citación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>formato_de_exportacion_de_citas</IRI>
        <Literal xml:lang="en">citation export format</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>formato_de_exportacion_de_citas</IRI>
        <Literal xml:lang="en">citation format</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>formato_de_exportacion_de_citas</IRI>
        <Literal xml:lang="es">Estándar en el que un repositorio permite exportar la referencia bibliográfica de sus contenidos para usarla en gestores bibliográficos. Facilita la citación de datos. Ejemplos: BibTeX, RIS.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>formato_de_exportacion_de_citas</IRI>
        <Literal xml:lang="en">Standard in which a repository allows exporting the bibliographic reference of its contents for use in reference managers. It eases data citation. Examples: BibTeX, RIS.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <Class IRI="esquema_de_metadatos"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="esquema_de_metadatos"/>
        <Class IRI="estandar"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>esquema_de_metadatos</IRI>
        <Literal xml:lang="es">esquema de metadatos</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>esquema_de_metadatos</IRI>
        <Literal xml:lang="en">metadata schema</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>esquema_de_metadatos</IRI>
        <Literal xml:lang="es">estándar de metadatos</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>esquema_de_metadatos</IRI>
        <Literal xml:lang="es">modelo de metadatos</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>esquema_de_metadatos</IRI>
        <Literal xml:lang="en">metadata standard</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>esquema_de_metadatos</IRI>
        <Literal xml:lang="en">metadata model</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>esquema_de_metadatos</IRI>
        <Literal xml:lang="es">Estructura común, a menudo estándar dentro de una comunidad, que define qué metadatos describen a un recurso y cómo. Va desde estándares enfocados en la interoperabilidad sintáctica hasta modelos conceptuales enfocados en la semántica. Permite a repositorios y agregadores intercambiar información sobre las colecciones. Ejemplos: DataCite Metadata Schema, DDI-Lifecycle. Se pobla con los estándares de formato y modelado de FAIRsharing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>esquema_de_metadatos</IRI>
        <Literal xml:lang="en">Common structure, often a standard within a community, defining which metadata describe a resource and how. It ranges from standards focused on syntactic interoperability to conceptual models focused on semantics. It allows repositories and aggregators to exchange information about datasets. Examples: DataCite Metadata Schema, DDI-Lifecycle. It is populated from FAIRsharing format and modeling standards.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <ObjectProperty IRI="extiende_a_esquema_de_metadatos"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>extiende_a_esquema_de_metadatos</IRI>
        <Literal xml:lang="es">extiende a esquema de metadatos</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>extiende_a_esquema_de_metadatos</IRI>
        <Literal xml:lang="en">extends metadata schema</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>extiende_a_esquema_de_metadatos</IRI>
        <Literal xml:lang="es">Indica que un esquema de metadatos extiende a otro, de modo que es posible definir funciones de mapeo entre ambos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>extiende_a_esquema_de_metadatos</IRI>
        <Literal xml:lang="en">States that a metadata schema extends another, so that mapping functions can be defined between them.</Literal>
    </AnnotationAssertion>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="extiende_a_esquema_de_metadatos"/>
        <Class IRI="esquema_de_metadatos"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="extiende_a_esquema_de_metadatos"/>
        <Class IRI="esquema_de_metadatos"/>
    </ObjectPropertyRange>
    <TransitiveObjectProperty>
        <ObjectProperty IRI="extiende_a_esquema_de_metadatos"/>
    </TransitiveObjectProperty>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="extiende_a_esquema_de_metadatos"/>
        <ObjectProperty IRI="extiende_de_estandar"/>
    </SubObjectPropertyOf>

