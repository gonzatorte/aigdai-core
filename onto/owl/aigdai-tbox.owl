    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>locacion</IRI>
        <Literal xml:lang="en">region</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>locacion</IRI>
        <Literal xml:lang="es">Lugar geográfico (país, región o ciudad) donde se ubica un repositorio u organización. Determina el marco regulatorio y los lineamientos locales que deben respetarse. Las locaciones se anidan mediante locacion_incluida_en.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>locacion</IRI>
        <Literal xml:lang="en">Geographic place (country, region or city) where a repository or organization is located. It determines the regulatory framework and local guidelines that must be respected. Locations are nested through locacion_incluida_en.</Literal>
    </AnnotationAssertion>
    <Declaration>
        <DataProperty IRI="nombre_de_locacion"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>nombre_de_locacion</IRI>
        <Literal xml:lang="es">nombre de locación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>nombre_de_locacion</IRI>
        <Literal xml:lang="en">location name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>nombre_de_locacion</IRI>
        <Literal xml:lang="es">Nombre de la locación.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>nombre_de_locacion</IRI>
        <Literal xml:lang="en">Name of the location.</Literal>
    </AnnotationAssertion>
    <DataPropertyDomain>
        <DataProperty IRI="nombre_de_locacion"/>
        <Class IRI="locacion"/>
    </DataPropertyDomain>
    <DataPropertyRange>
        <DataProperty IRI="nombre_de_locacion"/>
        <Datatype abbreviatedIRI="xsd:string"/>
    </DataPropertyRange>
    <Declaration>
        <ObjectProperty IRI="locacion_incluida_en"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>locacion_incluida_en</IRI>
        <Literal xml:lang="es">locación incluida en</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>locacion_incluida_en</IRI>
        <Literal xml:lang="en">location is included in</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>locacion_incluida_en</IRI>
        <Literal xml:lang="es">forma parte de</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>locacion_incluida_en</IRI>
        <Literal xml:lang="en">is part of</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>locacion_incluida_en</IRI>
        <Literal xml:lang="es">Indica que una locación está geográficamente contenida en otra (p. ej. una ciudad en un país).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>locacion_incluida_en</IRI>
        <Literal xml:lang="en">States that a location is geographically contained in another (e.g. a city in a country).</Literal>
    </AnnotationAssertion>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="locacion_incluida_en"/>
        <Class IRI="locacion"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="locacion_incluida_en"/>
        <Class IRI="locacion"/>
    </ObjectPropertyRange>
    <TransitiveObjectProperty>
        <ObjectProperty IRI="locacion_incluida_en"/>
    </TransitiveObjectProperty>

