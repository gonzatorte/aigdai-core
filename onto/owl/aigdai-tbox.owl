    <!-- Individuos: lectura, escritura, lectura_y_escritura -->
    <Declaration>
        <Class IRI="nivel_de_acceso"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="nivel_de_acceso"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>nivel_de_acceso</IRI>
        <Literal xml:lang="en">access level</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>nivel_de_acceso</IRI>
        <Literal xml:lang="es">nivel de acceso</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>nivel_de_acceso</IRI>
        <Literal xml:lang="es">permiso de acceso</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>nivel_de_acceso</IRI>
        <Literal xml:lang="en">access permission</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>nivel_de_acceso</IRI>
        <Literal xml:lang="es">Tipo de operación que habilita un servicio de acceso a datos: lectura, escritura o lectura y escritura. Tomado de la ontología de re3data. Los niveles se ordenan mediante es_acceso_mas_amplio.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>nivel_de_acceso</IRI>
        <Literal xml:lang="en">Type of operation enabled by a data access service: read, write, or read and write. Taken from the re3data ontology. Levels are ordered through es_acceso_mas_amplio.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <ObjectProperty IRI="es_acceso_mas_amplio"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>es_acceso_mas_amplio</IRI>
        <Literal xml:lang="es">es acceso más amplio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>es_acceso_mas_amplio</IRI>
        <Literal xml:lang="en">is broader access</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>es_acceso_mas_amplio</IRI>
        <Literal xml:lang="es">Orden entre niveles de acceso: indica que un nivel habilita más operaciones que otro (p. ej. lectura y escritura respecto de lectura).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>es_acceso_mas_amplio</IRI>
        <Literal xml:lang="en">Order between access levels: states that one level enables more operations than another (e.g. read and write with respect to read).</Literal>
    </AnnotationAssertion>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="es_acceso_mas_amplio"/>
        <Class IRI="nivel_de_acceso"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="es_acceso_mas_amplio"/>
        <Class IRI="nivel_de_acceso"/>
    </ObjectPropertyRange>
    <TransitiveObjectProperty>
        <ObjectProperty IRI="es_acceso_mas_amplio"/>
    </TransitiveObjectProperty>

