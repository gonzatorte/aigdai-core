    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_usa_politica</IRI>
        <Literal xml:lang="en">Links a research repository to a policy it applies or adheres to (e.g. deposit, preservation or data usage policies).</Literal>
    </AnnotationAssertion>

    <Declaration>
        <Class IRI="politica"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="politica"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>politica</IRI>
        <Literal xml:lang="en">policy</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>politica</IRI>
        <Literal xml:lang="es">política</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>politica</IRI>
        <Literal xml:lang="es">lineamiento</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>politica</IRI>
        <Literal xml:lang="es">mandato</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>politica</IRI>
        <Literal xml:lang="en">guideline</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>politica</IRI>
        <Literal xml:lang="en">mandate</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>politica</IRI>
        <Literal xml:lang="es">Conjunto de restricciones o recomendaciones impuestas por un actor del proceso de investigación (organización, agencia de financiación, revista, comunidad o el propio repositorio) sobre la gestión, depósito y apertura de los datos. Suele ser un documento poco estructurado que se interpreta manualmente, aunque puede incluir partes estructuradas (p. ej. planes de gestión de datos). Puede recomendar estándares y repositorios. Se pobla principalmente desde FAIRsharing y re3data.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>politica</IRI>
        <Literal xml:lang="en">Set of restrictions or recommendations imposed by an actor of the research process (organization, funding agency, journal, community or the repository itself) on managing, depositing and opening data. It is usually a loosely structured document interpreted manually, although it may include structured parts (e.g. data management plans). It may recommend standards and repositories. It is populated mainly from FAIRsharing and re3data.</Literal>
    </AnnotationAssertion>

