    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>protocolo_de_metricas</IRI>
        <Literal xml:lang="en">usage metrics standard</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
