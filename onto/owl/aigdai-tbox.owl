        <IRI>estandar_relacionado_con_estandar</IRI>
        <Literal xml:lang="en">Generic relation between linked standards (e.g. schemas with mappings between them).</Literal>
    </AnnotationAssertion>

    <Declaration>
        <ObjectProperty IRI="extiende_de_estandar"/>
    </Declaration>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="extiende_de_estandar"/>
        <ObjectProperty IRI="estandar_relacionado_con_estandar"/>
    </SubObjectPropertyOf>
    <TransitiveObjectProperty>
        <ObjectProperty IRI="extiende_de_estandar"/>
    </TransitiveObjectProperty>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>extiende_de_estandar</IRI>
        <Literal xml:lang="en">extends from standard</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>extiende_de_estandar</IRI>
        <Literal xml:lang="es">extiende de estándar</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>extiende_de_estandar</IRI>
        <Literal xml:lang="es">Indica que un estándar amplía a otro agregando elementos, de modo que lo expresado en el estándar base sigue siendo válido.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>extiende_de_estandar</IRI>
        <Literal xml:lang="en">States that a standard broadens another by adding elements, so that what is expressed in the base standard remains valid.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <ObjectProperty IRI="perfila_estandar"/>
    </Declaration>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="perfila_estandar"/>
        <ObjectProperty IRI="estandar_relacionado_con_estandar"/>
    </SubObjectPropertyOf>
    <TransitiveObjectProperty>
        <ObjectProperty IRI="perfila_estandar"/>
    </TransitiveObjectProperty>
    <AnnotationAssertion>
