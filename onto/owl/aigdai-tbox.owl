        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>estadistico_generado_en_fecha_desde</IRI>
        <Literal xml:lang="en">Lower bound (earliest possible instant, UTC) derived from estadistico_generado_en_fecha, so that variable-granularity dates can be compared in SPARQL.</Literal>
    </AnnotationAssertion>
