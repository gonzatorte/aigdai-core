        <Literal>http://doi.org/10.2312/re3.006</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:basado_en"/>
        <IRI>soporta_enlace_con_articulo</IRI>
        <Literal>https://fairsharing.gitbook.io/fairsharing/additional-information/database-conditions#citation-to-related-publications</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>soporta_enlace_con_articulo</IRI>
        <Literal xml:lang="es">Indica si el repositorio de datos permite vincular sus colecciones con las publicaciones asociadas. Contar con ambos elementos correctamente relacionados mejora la capacidad de validar los resultados de investigación.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>soporta_enlace_con_articulo</IRI>
        <Literal xml:lang="en">Indicates whether the data repository allows linking its datasets to the related publications. Having both properly related improves the ability to validate research results.</Literal>
    </AnnotationAssertion>

