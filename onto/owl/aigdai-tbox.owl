        <Literal xml:lang="es">Cota inferior (primer instante posible, UTC) derivada de estadistico_generado_en_fecha</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>estadistico_generado_en_fecha_desde</IRI>
