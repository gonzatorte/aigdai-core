        <!-- Estándares, formatos, esquemas, licencia, política -->
        <ObjectUnionOf>
            <Class IRI="estandar"/>
            <Class IRI="tipo_de_dato"/>
            <Class IRI="formato_de_exportacion_de_citas"/>
            <Class IRI="formato_de_sindicacion"/>
            <Class IRI="tipo_de_id_de_organizacion"/>
            <Class IRI="esquema_de_id_de_autor"/>
            <Class IRI="esquema_de_id_persistente"/>
            <Class IRI="esquema_de_metadatos"/>
            <Class IRI="protocolo_de_cosecha"/>
            <Class IRI="protocolo_de_metricas"/>
            <Class IRI="licencia"/>
            <Class IRI="politica"/>
        </ObjectUnionOf>

        <!-- IDs, etiquetas y redes sociales -->
        <ObjectUnionOf>
            <Class IRI="id_de_autor"/>
            <Class IRI="id_de_organizacion"/>
            <Class IRI="id_de_repositorio"/>
            <Class IRI="id_de_resultado_de_investigacion"/>
            <Class IRI="disciplina"/>
            <Class IRI="palabra_clave"/>
            <Class IRI="red_social"/>
        </ObjectUnionOf>

        <!-- Entidades “materiales”: cosas que existen en el mundo -->
        <ObjectUnionOf>
            <Class IRI="locacion"/>
            <Class IRI="organizacion"/>
            <Class IRI="repositorio_de_investigacion"/>
            <Class IRI="resultado_de_investigacion"/>
            <Class IRI="catalogo_de_repositorios"/>
            <Class IRI="autor"/>
            <Class IRI="software"/>
        </ObjectUnionOf>
    </DisjointClasses>
