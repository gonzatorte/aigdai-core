    <Declaration>
        <Class IRI="formato_de_archivo"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="formato_de_archivo"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>formato_de_archivo</IRI>
        <Literal xml:lang="en">file format</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>formato_de_archivo</IRI>
        <Literal xml:lang="es">formato de archivo</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>formato_de_archivo</IRI>
        <Literal xml:lang="es">tipo de archivo</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>formato_de_archivo</IRI>
        <Literal xml:lang="en">file type</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>formato_de_archivo</IRI>
        <Literal xml:lang="en">MIME type</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>formato_de_archivo</IRI>
        <Literal xml:lang="es">Codificación con la que se almacena un archivo digital (p. ej. CSV, PDF). Que un repositorio soporte los formatos usados por su comunidad es un aspecto del principio TRUST de enfoque en el usuario.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>formato_de_archivo</IRI>
        <Literal xml:lang="en">Encoding used to store a digital file (e.g. CSV, PDF). A repository supporting the formats used by its community is an aspect of the TRUST user-focus principle.</Literal>
    </AnnotationAssertion>
    <Declaration>
        <Class IRI="formato_de_archivo_abierto"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>formato_de_archivo_abierto</IRI>
        <Literal xml:lang="es">formato de archivo abierto</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>formato_de_archivo_abierto</IRI>
        <Literal xml:lang="en">open file format</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>formato_de_archivo_abierto</IRI>
        <Literal xml:lang="es">formato abierto</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>formato_de_archivo_abierto</IRI>
        <Literal xml:lang="en">open format</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>formato_de_archivo_abierto</IRI>
        <Literal xml:lang="es">Formato de archivo cuya especificación es pública y utilizable sin restricciones (p. ej. CSV). Los principios FAIR y las guías para repositorios recomiendan preferirlos para favorecer la preservación y la reutilización.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>formato_de_archivo_abierto</IRI>
        <Literal xml:lang="en">File format whose specification is public and usable without restrictions (e.g. CSV). The FAIR principles and repository guidelines recommend preferring them to favor preservation and reuse.</Literal>
    </AnnotationAssertion>
    <SubClassOf>
        <Class IRI="formato_de_archivo_abierto"/>
        <Class IRI="formato_de_archivo"/>
    </SubClassOf>
    <Declaration>
        <Class IRI="tipo_de_dato"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>tipo_de_dato</IRI>
        <Literal xml:lang="es">tipo de dato</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>tipo_de_dato</IRI>
        <Literal xml:lang="en">data type</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>tipo_de_dato</IRI>
        <Literal xml:lang="es">tipo de recurso</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>tipo_de_dato</IRI>
        <Literal xml:lang="es">tipo de contenido</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>tipo_de_dato</IRI>
        <Literal xml:lang="en">resource type</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>tipo_de_dato</IRI>
        <Literal xml:lang="en">content type</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>tipo_de_dato</IRI>
        <Literal xml:lang="es">Categoría de recurso de investigación según su naturaleza (p. ej. conjunto de datos, software). Se alinea con el vocabulario de tipos de recurso de COAR, que re3data usa para declarar los tipos de contenido que acepta un repositorio.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>tipo_de_dato</IRI>
        <Literal xml:lang="en">Category of research resource according to its nature (e.g. dataset, software). It is aligned with the COAR resource types vocabulary, which re3data uses to declare the content types a repository accepts.</Literal>
    </AnnotationAssertion>
    <SubClassOf>
        <Class IRI="tipo_de_dato"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <SubClassOf>
        <Class abbreviatedIRI="coar_types:coar_resource_type"/>
        <Class IRI="tipo_de_dato"/>
    </SubClassOf>

    <Declaration>
