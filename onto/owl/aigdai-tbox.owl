        <IRI>red_social</IRI>
        <Literal xml:lang="en">social media</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>red_social</IRI>
        <Literal xml:lang="en">community platform</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>red_social</IRI>
        <Literal xml:lang="es">Plataforma de comunicación en línea (p. ej. foros, X/Twitter) con la que un repositorio se integra para difundir contenidos o dar soporte a su comunidad de usuarios.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>red_social</IRI>
        <Literal xml:lang="en">Online communication platform (e.g. forums, X/Twitter) that a repository integrates with to disseminate contents or support its user community.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <Class IRI="repositorio"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="repositorio"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio</IRI>
        <Literal xml:lang="es">repositorio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio</IRI>
        <Literal xml:lang="en">repository</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio</IRI>
        <Literal xml:lang="en">archive</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio</IRI>
        <Literal xml:lang="es">archivo</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio</IRI>
        <Literal xml:lang="es">repositorio digital</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio</IRI>
        <Literal xml:lang="en">digital repository</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio</IRI>
        <Literal xml:lang="es">Archivo en línea para el almacenamiento, preservación y difusión de objetos digitales, como resultados de investigación, manuscritos, código o datos. Es el concepto raíz de la taxonomía de repositorios, que incluye repositorios de artículos, de software y de datos de investigación, y permite distinguir las características propias de cada tipo. Según el modelo OAIS, un repositorio debe preservar la información a largo plazo y garantizar su acceso y comprensión por parte de una comunidad designada. Sus metadatos provienen principalmente de catálogos como re3data, FAIRsharing y DataCite.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio</IRI>
        <Literal xml:lang="en">Online archive for storing, preserving and disseminating digital objects such as research outputs, manuscripts, code or data. It is the root concept of the repository taxonomy, which includes article, software and research data repositories, and allows distinguishing the characteristics of each type. According to the OAIS model, a repository must preserve information in the long term and guarantee its access and understanding by a designated community. Its metadata comes mainly from catalogs such as re3data, FAIRsharing and DataCite.</Literal>
    </AnnotationAssertion>
    <HasKey>
        <Class IRI="repositorio"/>
        <ObjectInverseOf>
            <ObjectProperty IRI="id_de_repositorio_tiene_repositorio"/>
        </ObjectInverseOf>
    </HasKey>

    <Declaration>
        <Class IRI="palabra_clave"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="palabra_clave"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>palabra_clave</IRI>
        <Literal xml:lang="es">palabra clave</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>palabra_clave</IRI>
        <Literal xml:lang="en">keyword</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>palabra_clave</IRI>
        <Literal xml:lang="es">etiqueta</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>palabra_clave</IRI>
        <Literal xml:lang="es">término clave</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>palabra_clave</IRI>
        <Literal xml:lang="en">tag</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>palabra_clave</IRI>
        <Literal xml:lang="en">user-defined tag</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>palabra_clave</IRI>
        <Literal xml:lang="es">Término libre que describe temas, técnicas u objetos de estudio de un repositorio, complementando la clasificación por disciplinas con un vocabulario más cercano a las comunidades. Proviene de las palabras clave de re3data y DataCite y de las etiquetas definidas por usuarios en FAIRsharing, e incluye sus sinónimos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>palabra_clave</IRI>
        <Literal xml:lang="en">Free term describing topics, techniques or objects of study of a repository, complementing the discipline classification with a vocabulary closer to communities. It comes from re3data and DataCite keywords and from FAIRsharing user-defined tags, and includes their synonyms.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <DataProperty IRI="tiene_sinonimo_palabra_clave"/>
