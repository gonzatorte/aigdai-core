        <Literal xml:lang="es">nombre del estándar</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>tiene_nombre_estandar</IRI>
        <Literal xml:lang="en">standard name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>tiene_nombre_estandar</IRI>
        <Literal xml:lang="es">Nombre o acrónimo del estándar (p. ej. 'DataCite Metadata Schema', 'OAI-PMH').</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>tiene_nombre_estandar</IRI>
        <Literal xml:lang="en">Name or acronym of the standard (e.g. 'DataCite Metadata Schema', 'OAI-PMH').</Literal>
    </AnnotationAssertion>
    <DataPropertyDomain>
