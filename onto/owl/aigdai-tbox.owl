    <Declaration>
        <Class IRI="nivel_de_apertura"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="nivel_de_apertura"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>nivel_de_apertura</IRI>
        <Literal xml:lang="en">openness level</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>nivel_de_apertura</IRI>
        <Literal xml:lang="es">nivel de apertura</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>nivel_de_apertura</IRI>
        <Literal xml:lang="es">restricción de acceso</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>nivel_de_apertura</IRI>
        <Literal xml:lang="en">access restriction</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>nivel_de_apertura</IRI>
        <Literal xml:lang="es">Grado de apertura de un repositorio para una operación dada: abierto, restringido o cerrado. Se distingue la apertura para lectura (acceso a los datos) de la apertura para escritura (depósito de datos), según los atributos de acceso y depósito de re3data. Los niveles se ordenan mediante es_nivel_mas_abierto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>nivel_de_apertura</IRI>
        <Literal xml:lang="en">Degree of openness of a repository for a given operation: open, restricted or closed. Openness for reading (data access) is distinguished from openness for writing (data deposit), following re3data access and upload attributes. Levels are ordered through es_nivel_mas_abierto.</Literal>
    </AnnotationAssertion>

    <!-- Individuos: abierto_para_escritura, cerrado_para_escritura, restringido_para_escritura -->
