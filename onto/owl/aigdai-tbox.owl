    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_asociado_a_software</IRI>
        <Literal xml:lang="en">Links a repository to the software that implements it (e.g. Dataverse). The software partly defines the features the repository can offer and allows estimating them.</Literal>
