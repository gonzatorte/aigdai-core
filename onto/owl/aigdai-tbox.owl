    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>esquema_de_id_de_autor</IRI>
        <Literal xml:lang="es">Estándar que define un sistema de identificadores para autores e investigadores (p. ej. ORCID). Que un repositorio acepte estos esquemas facilita la atribución y la integración de sus metadatos con otros servicios.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>esquema_de_id_de_autor</IRI>
        <Literal xml:lang="en">Standard defining an identifier system for authors and researchers (e.g. ORCID). A repository accepting these schemes eases attribution and integration of its metadata with other services.</Literal>
    </AnnotationAssertion>
