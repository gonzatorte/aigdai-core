    <Declaration>
        <Class IRI="repositorio_de_investigacion"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="repositorio_de_investigacion"/>
        <Class IRI="repositorio"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio_de_investigacion</IRI>
        <Literal xml:lang="en">research repository</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio_de_investigacion</IRI>
        <Literal xml:lang="es">repositorio de investigación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio_de_investigacion</IRI>
        <Literal xml:lang="es">repositorio académico</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio_de_investigacion</IRI>
        <Literal xml:lang="en">scholarly repository</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_de_investigacion</IRI>
        <Literal xml:lang="es">Repositorio que aloja resultados del proceso de investigación (artículos, colecciones de datos, software, etc.) y que implementa flujos de trabajo propios de la comunicación científica, como la asignación de identificadores persistentes, la exportación de citas o la cosecha de metadatos por agregadores. Puede ser institucional o huérfano (sin institución), disciplinario o generalista. Es el dominio de la mayoría de las relaciones sobre estándares, políticas y licencias.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_de_investigacion</IRI>
        <Literal xml:lang="en">Repository hosting outputs of the research process (articles, datasets, software, etc.) and implementing workflows typical of scholarly communication, such as assigning persistent identifiers, exporting citations or having its metadata harvested by aggregators. It can be institutional or orphan (without institution), disciplinary or generalist. It is the domain of most relations about standards, policies and licenses.</Literal>
    </AnnotationAssertion>

