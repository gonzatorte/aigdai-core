    <Declaration>
        <ObjectProperty IRI="repositorio_satisface_criterio"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio_satisface_criterio</IRI>
        <Literal xml:lang="es">repositorio satisface criterio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio_satisface_criterio</IRI>
        <Literal xml:lang="en">repository satisfies criterion</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio_satisface_criterio</IRI>
        <Literal xml:lang="es">repositorio cumple criterio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
