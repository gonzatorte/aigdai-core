    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>esquema_de_id_persistente</IRI>
        <Literal xml:lang="en">persistent identifier type</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>esquema_de_id_persistente</IRI>
        <Literal xml:lang="es">Estándar que define un sistema de identificadores globales y persistentes para objetos digitales (p. ej. DOI, Handle). Los principios FAIR (F1) exigen asignar este tipo de identificadores a los datos y metadatos, por lo que el esquema aceptado es una variable de calidad del repositorio.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>esquema_de_id_persistente</IRI>
        <Literal xml:lang="en">Standard defining a system of global persistent identifiers for digital objects (e.g. DOI, Handle). The FAIR principles (F1) require assigning such identifiers to data and metadata, so the accepted scheme is a quality variable of the repository.</Literal>
    </AnnotationAssertion>
    <Declaration>
        <ObjectProperty IRI="extiende_a_esquema_de_id_persistente"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>extiende_a_esquema_de_id_persistente</IRI>
        <Literal xml:lang="es">extiende a esquema de ID persistente</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>extiende_a_esquema_de_id_persistente</IRI>
        <Literal xml:lang="en">extends PID schema</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>extiende_a_esquema_de_id_persistente</IRI>
        <Literal xml:lang="es">Indica que un esquema de identificadores persistentes se construye sobre otro (p. ej. DOI se implementa sobre Handle).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>extiende_a_esquema_de_id_persistente</IRI>
        <Literal xml:lang="en">States that a persistent identifier scheme is built on top of another one (e.g. DOI is implemented on top of Handle).</Literal>
    </AnnotationAssertion>
