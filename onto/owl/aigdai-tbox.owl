        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>formato_codifica_tipo_de_dato</IRI>
        <Literal xml:lang="es">formato codifica tipo de dato</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>formato_codifica_tipo_de_dato</IRI>
