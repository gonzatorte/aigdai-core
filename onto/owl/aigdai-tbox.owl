        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>formato_codifica_tipo_de_dato</IRI>
        <Literal xml:lang="es">Indica que un formato de archivo es adecuado para codificar un tipo de dato dado (p. ej. CSV para datos tabulares).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>formato_codifica_tipo_de_dato</IRI>
        <Literal xml:lang="en">States that a file format is suitable to encode a given data type (e.g. CSV for tabular data).</Literal>
    </AnnotationAssertion>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="formato_codifica_tipo_de_dato"/>
