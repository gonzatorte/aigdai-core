    <Declaration>
        <Class IRI="articulo"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>articulo</IRI>
        <Literal xml:lang="es">artículo</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>articulo</IRI>
        <Literal xml:lang="en">article</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>articulo</IRI>
        <Literal xml:lang="es">publicación científica</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>articulo</IRI>
        <Literal xml:lang="es">artículo de investigación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>articulo</IRI>
        <Literal xml:lang="en">scholarly article</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>articulo</IRI>
        <Literal xml:lang="en">paper</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>articulo</IRI>
        <Literal xml:lang="es">Resultado de investigación que comunica hallazgos científicos en forma textual: artículos de revista revisados por pares, libros, informes o ponencias. Es el resultado más frecuente del proceso de investigación. Vincularlo con las colecciones de datos que lo respaldan mejora la validación de sus resultados.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>articulo</IRI>
        <Literal xml:lang="en">Research output communicating scientific findings in textual form: peer-reviewed journal articles, books, reports or conference papers. It is the most frequent output of the research process. Linking it to the datasets that support it improves the validation of its results.</Literal>
    </AnnotationAssertion>
    <SubClassOf>
        <Class IRI="articulo"/>
        <Class IRI="resultado_de_investigacion"/>
    </SubClassOf>
    <Declaration>
        <Class IRI="cdd"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="cdd"/>
        <Class IRI="resultado_de_investigacion"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>cdd</IRI>
        <Literal xml:lang="es">coleccion de datos</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>cdd</IRI>
        <Literal xml:lang="en">dataset</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>cdd</IRI>
        <Literal xml:lang="es">conjunto de datos</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>cdd</IRI>
        <Literal xml:lang="es">colección de datos de investigación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>cdd</IRI>
        <Literal xml:lang="en">data collection</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>cdd</IRI>
        <Literal xml:lang="en">research dataset</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>cdd</IRI>
        <Literal xml:lang="es">Conjunto de datos de investigación relacionados bajo un mismo criterio o temática, que comparten una estructura lógica común descrita por sus metadatos (creación, procedencia, tamaño, formatos, disciplina, licencia, etc.). En la práctica se gestiona como una unidad indivisible para su curaduría, revisión y citación, por lo que se identifica con un identificador global y persistente. Dos colecciones con el mismo identificador persistente se consideran la misma.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>cdd</IRI>
        <Literal xml:lang="en">Set of related research data grouped under a common criterion or topic, sharing a logical structure described by its metadata (creation, provenance, size, formats, discipline, license, etc.). In practice it is managed as an indivisible unit for curation, review and citation, so it is identified by a global persistent identifier. Two datasets with the same persistent identifier are considered the same.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <Class IRI="disciplina"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="disciplina"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>disciplina</IRI>
        <Literal xml:lang="es">disciplina</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>disciplina</IRI>
        <Literal xml:lang="en">subject</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>disciplina</IRI>
        <Literal xml:lang="es">área de conocimiento</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>disciplina</IRI>
        <Literal xml:lang="es">campo de estudio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>disciplina</IRI>
        <Literal xml:lang="en">discipline</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>disciplina</IRI>
        <Literal xml:lang="en">research field</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>disciplina</IRI>
        <Literal xml:lang="en">subject area</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>disciplina</IRI>
        <Literal xml:lang="es">Categoría que agrupa a las comunidades científicas organizadas en torno a objetos de estudio afines. Cada disciplina tiene requisitos propios (políticas, esquemas de metadatos, lineamientos) que el investigador debe considerar al elegir un repositorio. Coexisten varias clasificaciones (p. ej. DFG, usada por re3data), por lo que cada disciplina indica su esquema y se relacionan jerárquicamente. Se usa también como aproximación al concepto de comunidad.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>disciplina</IRI>
        <Literal xml:lang="en">Category grouping the scientific communities organized around related objects of study. Each discipline has its own requirements (policies, metadata schemas, guidelines) that researchers must consider when choosing a repository. Several classifications coexist (e.g. DFG, used by re3data), so each discipline states its scheme and they are related hierarchically. It is also used as an approximation of the concept of community.</Literal>
    </AnnotationAssertion>

    <Declaration>
