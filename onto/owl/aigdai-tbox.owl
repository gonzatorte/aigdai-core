        <Literal>https://fairsharing.gitbook.io/fairsharing/record-sections-and-fields/general-information/countries</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:basado_en"/>
        <IRI>repositorio_se_ubica_en</IRI>
        <Literal>http://doi.org/10.2312/re3.006</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio_se_ubica_en</IRI>
        <Literal xml:lang="es">país del repositorio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio_se_ubica_en</IRI>
        <Literal xml:lang="en">repository country</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_se_ubica_en</IRI>
        <Literal xml:lang="es">Relaciona un repositorio con la locación (típicamente un país) cuyas regulaciones y lineamientos debe respetar.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_se_ubica_en</IRI>
        <Literal xml:lang="en">Links a repository to the location (typically a country) whose regulations and guidelines it must comply with.</Literal>
    </AnnotationAssertion>

