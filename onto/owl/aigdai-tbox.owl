        <IRI>pais</IRI>
        <Literal xml:lang="es">nación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>pais</IRI>
        <Literal xml:lang="en">nation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>pais</IRI>
        <Literal xml:lang="es">Locación que corresponde a un país, identificado por su código ISO 3166-1 alfa-3. Es la granularidad más usada por los catálogos para ubicar repositorios y organizaciones.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>pais</IRI>
        <Literal xml:lang="en">Location corresponding to a country, identified by its ISO 3166-1 alpha-3 code. It is the granularity most used by catalogs to locate repositories and organizations.</Literal>
    </AnnotationAssertion>
