    </DataPropertyRange>

    <Declaration>
        <ObjectProperty IRI="estandar_relacionado_con_estandar"/>
    </Declaration>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="estandar_relacionado_con_estandar"/>
        <Class IRI="estandar"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
