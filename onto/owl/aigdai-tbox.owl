        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>soporta_versionado_repositorio</IRI>
        <Literal xml:lang="es">Indica si el repositorio de datos permite gestionar versiones de las colecciones depositadas, manteniendo el acceso y la citación de versiones anteriores.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>soporta_versionado_repositorio</IRI>
        <Literal xml:lang="en">Indicates whether the data repository supports managing versions of deposited datasets, keeping earlier versions accessible and citable.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <Class IRI="software"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>software</IRI>
        <Literal xml:lang="es">software de repositorio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>software</IRI>
        <Literal xml:lang="en">repository software</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>software</IRI>
        <Literal xml:lang="es">plataforma de repositorio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>software</IRI>
        <Literal xml:lang="es">motor</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>software</IRI>
        <Literal xml:lang="en">repository platform</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>software</IRI>
        <Literal xml:lang="es">Software que implementa un repositorio (p. ej. DSpace, Dataverse). Define en parte las funcionalidades que un repositorio puede proveer (APIs, protocolos de cosecha, esquemas de metadatos, versionado), por lo que permite estimar características del repositorio que no se declaran explícitamente. Se pobla con los conceptos de API y software de re3data y de herramientas de FAIRsharing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>software</IRI>
        <Literal xml:lang="en">Software implementing a repository (e.g. DSpace, Dataverse). It partly defines the features a repository can provide (APIs, harvesting protocols, metadata schemas, versioning), so it allows estimating repository characteristics that are not explicitly declared. It is populated from re3data API and software concepts and FAIRsharing tools.</Literal>
    </AnnotationAssertion>
    <SubClassOf>
        <Class IRI="software"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>

