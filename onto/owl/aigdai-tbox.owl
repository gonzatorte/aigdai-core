    <!-- START Cosas relativas a los estándares -->
    <Declaration>
        <Class IRI="estandar"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="estandar"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>estandar</IRI>
        <Literal xml:lang="en">standard</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>estandar</IRI>
        <Literal xml:lang="es">estándar</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>estandar</IRI>
        <Literal xml:lang="es">norma</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>estandar</IRI>
        <Literal xml:lang="es">especificación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>estandar</IRI>
        <Literal xml:lang="en">specification</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>estandar</IRI>
        <Literal xml:lang="es">Conjunto de formatos, protocolos, esquemas o convenciones acordados por una comunidad que permiten la interoperabilidad entre sistemas. Agrupa los esquemas de metadatos, los protocolos de cosecha y de métricas, los formatos de sindicación y de exportación de citas, y los esquemas de identificadores. Los estándares pueden relacionarse, extenderse o perfilarse entre sí, y ser recomendados por políticas. Su fuente principal es el registro de estándares de FAIRsharing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>estandar</IRI>
        <Literal xml:lang="en">Set of formats, protocols, schemas or conventions agreed upon by a community that enable interoperability between systems. It groups metadata schemas, harvesting and metrics protocols, syndication and citation export formats, and identifier schemes. Standards can be related to, extend or profile each other, and be recommended by policies. Its main source is the FAIRsharing standards registry.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <DataProperty IRI="tiene_nombre_estandar"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>tiene_nombre_estandar</IRI>
        <Literal xml:lang="es">tiene nombre estándar</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>tiene_nombre_estandar</IRI>
        <Literal xml:lang="en">standard has name</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
