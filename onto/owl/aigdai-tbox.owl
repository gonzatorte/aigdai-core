        <Literal xml:lang="es">Fecha en que se calculó o extrajo el estadístico.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>estadistico_generado_en_fecha</IRI>
        <Literal xml:lang="en">Date on which the statistic was computed or extracted.</Literal>
