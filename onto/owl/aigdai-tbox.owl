    <Declaration>
        <Datatype IRI="escala"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>escala</IRI>
        <Literal xml:lang="es">escala</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>escala</IRI>
        <Literal xml:lang="en">scale</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>escala</IRI>
        <Literal xml:lang="es">Tipo de datos enumerado para valoraciones cualitativas simples, con los valores 'bueno', 'regular' y 'malo'.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>escala</IRI>
        <Literal xml:lang="en">Enumerated datatype for simple qualitative ratings, with the values 'bueno' (good), 'regular' (fair) and 'malo' (bad).</Literal>
    </AnnotationAssertion>
    <DatatypeDefinition>
        <Datatype IRI="escala"/>
        <DataOneOf>
            <Literal>bueno</Literal>
            <Literal>malo</Literal>
            <Literal>regular</Literal>
        </DataOneOf>
    </DatatypeDefinition>

    <Declaration>
        <Datatype IRI="duration"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>duration</IRI>
        <Literal xml:lang="es">duración</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>duration</IRI>
        <Literal xml:lang="en">duration</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>duration</IRI>
        <Literal xml:lang="es">Tipo de datos para duraciones de tiempo (p. ej. períodos de embargo). Conceptualmente corresponde a xsd:duration, pero se define como texto para tolerar los valores heterogéneos declarados por los catálogos de origen.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>duration</IRI>
        <Literal xml:lang="en">Datatype for time durations (e.g. embargo periods). Conceptually equivalent to xsd:duration, but defined as a string to tolerate the heterogeneous values declared by source catalogs.</Literal>
    </AnnotationAssertion>
    <DatatypeDefinition>
        <Datatype IRI="duration"/>
        <!--  xsd:duration    -->
        <DataUnionOf>
            <Datatype abbreviatedIRI="xsd:string"/>
        </DataUnionOf>
    </DatatypeDefinition>

    <Declaration>
        <Datatype IRI="url"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>url</IRI>
        <Literal xml:lang="es">URL</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>url</IRI>
        <Literal xml:lang="en">URL</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>url</IRI>
        <Literal xml:lang="es">dirección web</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>url</IRI>
        <Literal xml:lang="en">web address</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>url</IRI>
        <Literal xml:lang="es">Tipo de datos para direcciones web (URL). Conceptualmente corresponde a xsd:anyURI, pero se define como texto porque muchas direcciones extraídas de los catálogos no son URIs sintácticamente válidas.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>url</IRI>
        <Literal xml:lang="en">Datatype for web addresses (URLs). Conceptually equivalent to xsd:anyURI, but defined as a string because many addresses extracted from catalogs are not syntactically valid URIs.</Literal>
    </AnnotationAssertion>
    <DatatypeDefinition>
        <Datatype IRI="url"/>
        <DataUnionOf>
            <Datatype abbreviatedIRI="xsd:string"/>
        </DataUnionOf>
<!--         <DataUnionOf> -->
<!--             <Datatype abbreviatedIRI="xsd:anyURI"/> -->
<!--         </DataUnionOf> -->
    </DatatypeDefinition>

    <Declaration>
        <Datatype abbreviatedIRI="lang:lenguaje"/>
    </Declaration>

    <Declaration>
        <Datatype IRI="positiveInteger_or_null"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>positiveInteger_or_null</IRI>
        <Literal xml:lang="es">entero positivo o nulo</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>positiveInteger_or_null</IRI>
        <Literal xml:lang="en">positive integer or null</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>positiveInteger_or_null</IRI>
        <Literal xml:lang="es">Tipo de datos que admite un entero positivo o el literal 'null', usado cuando la fuente declara explícitamente que el valor es desconocido (p. ej. el año de creación de un repositorio).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>positiveInteger_or_null</IRI>
        <Literal xml:lang="en">Datatype accepting a positive integer or the literal 'null', used when the source explicitly declares the value as unknown (e.g. a repository's creation year).</Literal>
    </AnnotationAssertion>
    <DatatypeDefinition>
        <Datatype IRI="positiveInteger_or_null"/>
        <DataUnionOf>
            <Datatype abbreviatedIRI="xsd:positiveInteger"/>
            <DataOneOf>
                <Literal>null</Literal>
            </DataOneOf>
        </DataUnionOf>
    </DatatypeDefinition>

    <Declaration>
        <Datatype IRI="boolean_or_unknown"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>boolean_or_unknown</IRI>
        <Literal xml:lang="es">booleano o desconocido</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>boolean_or_unknown</IRI>
        <Literal xml:lang="en">boolean or unknown</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>boolean_or_unknown</IRI>
        <Literal xml:lang="es">Tipo de datos que admite un valor booleano o el literal 'unknown', para distinguir un valor falso de la ausencia de información declarada por la fuente.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>boolean_or_unknown</IRI>
        <Literal xml:lang="en">Datatype accepting a boolean value or the literal 'unknown', to distinguish a false value from information that the source does not declare.</Literal>
    </AnnotationAssertion>
    <DatatypeDefinition>
        <Datatype IRI="boolean_or_unknown"/>
        <DataUnionOf>
            <Datatype abbreviatedIRI="xsd:boolean"/>
            <DataOneOf>
                <Literal>unknown</Literal>
            </DataOneOf>
        </DataUnionOf>
    </DatatypeDefinition>

    <Declaration>
        <Datatype IRI="gYear"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>gYear</IRI>
        <Literal xml:lang="es">año</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>gYear</IRI>
        <Literal xml:lang="en">year</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>gYear</IRI>
        <Literal xml:lang="es">Tipo de datos para fechas con granularidad de año (AAAA). Conceptualmente corresponde a xsd:gYear, pero se define como texto por compatibilidad con los razonadores.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>gYear</IRI>
        <Literal xml:lang="en">Datatype for dates with year granularity (YYYY). Conceptually equivalent to xsd:gYear, but defined as a string for reasoner compatibility.</Literal>
    </AnnotationAssertion>
    <DatatypeDefinition>
        <Datatype IRI="gYear"/>
        <DataUnionOf>
            <Datatype abbreviatedIRI="xsd:string"/>
        </DataUnionOf>
    </DatatypeDefinition>

    <Declaration>
        <Datatype IRI="gYearMonth"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>gYearMonth</IRI>
        <Literal xml:lang="es">año y mes</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>gYearMonth</IRI>
        <Literal xml:lang="en">year and month</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>gYearMonth</IRI>
        <Literal xml:lang="es">Tipo de datos para fechas con granularidad de mes (AAAA-MM). Conceptualmente corresponde a xsd:gYearMonth, pero se define como texto por compatibilidad con los razonadores.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>gYearMonth</IRI>
        <Literal xml:lang="en">Datatype for dates with month granularity (YYYY-MM). Conceptually equivalent to xsd:gYearMonth, but defined as a string for reasoner compatibility.</Literal>
    </AnnotationAssertion>
    <DatatypeDefinition>
        <Datatype IRI="gYearMonth"/>
        <DataUnionOf>
            <Datatype abbreviatedIRI="xsd:string"/>
        </DataUnionOf>
    </DatatypeDefinition>

    <Declaration>
        <Datatype IRI="date"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>date</IRI>
        <Literal xml:lang="es">fecha</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>date</IRI>
        <Literal xml:lang="en">date</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>date</IRI>
        <Literal xml:lang="es">Tipo de datos para fechas completas (AAAA-MM-DD). Conceptualmente corresponde a xsd:date, pero se define como texto por compatibilidad con los razonadores.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>date</IRI>
        <Literal xml:lang="en">Datatype for full dates (YYYY-MM-DD). Conceptually equivalent to xsd:date, but defined as a string for reasoner compatibility.</Literal>
    </AnnotationAssertion>
    <DatatypeDefinition>
        <!--  xsd:date    -->
        <Datatype IRI="date"/>
        <DataUnionOf>
            <Datatype abbreviatedIRI="xsd:string"/>
        </DataUnionOf>
    </DatatypeDefinition>

    <Declaration>
        <Datatype IRI="gross_date"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>gross_date</IRI>
        <Literal xml:lang="es">fecha de granularidad variable</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>gross_date</IRI>
        <Literal xml:lang="en">variable-granularity date</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>gross_date</IRI>
        <Literal xml:lang="es">fecha aproximada</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>gross_date</IRI>
        <Literal xml:lang="en">gross date</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>gross_date</IRI>
        <Literal xml:lang="es">Tipo de datos para fechas de granularidad variable: año, año y mes, o fecha completa. Refleja que los catálogos declaran fechas con distinta precisión. Para compararlas en SPARQL se derivan propiedades auxiliares con cotas inferior y superior (sufijos _desde y _hasta).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>gross_date</IRI>
        <Literal xml:lang="en">Datatype for variable-granularity dates: year, year and month, or full date. It reflects that catalogs declare dates with different precision. To compare them in SPARQL, auxiliary properties with lower and upper bounds are derived (suffixes _desde and _hasta).</Literal>
    </AnnotationAssertion>
    <DatatypeDefinition>
        <Datatype IRI="gross_date"/>
        <DataUnionOf>
            <Datatype IRI="gYear"/>
            <Datatype IRI="gYearMonth"/>
            <Datatype IRI="date"/>
        </DataUnionOf>
    </DatatypeDefinition>

    <Declaration>
        <Class IRI="agregador"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="agregador"/>
        <Class IRI="repositorio_de_investigacion"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>agregador</IRI>
        <Literal xml:lang="en">aggregator</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>agregador</IRI>
        <Literal xml:lang="es">agregador</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>agregador</IRI>
        <Literal xml:lang="es">buscador</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>agregador</IRI>
        <Literal xml:lang="es">proveedor de servicio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>agregador</IRI>
        <Literal xml:lang="en">service provider</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>agregador</IRI>
        <Literal xml:lang="en">harvester</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>agregador</IRI>
        <Literal xml:lang="es">Sistema que colecta o cosecha metadatos de otros repositorios fuente o de otros agregadores, por ejemplo mediante OAI-PMH, que lo denomina proveedor de servicio. No es estrictamente un repositorio: no posee información autoritativa sobre los contenidos ni gestiona su archivado, aunque puede complementar o corregir los metadatos recolectados. Que un repositorio y un agregador compartan software, protocolo de cosecha o esquema de metadatos facilita el indexado. Ejemplos: Google Dataset Search, LA Referencia.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>agregador</IRI>
        <Literal xml:lang="en">System that collects or harvests metadata from source repositories or from other aggregators, for instance via OAI-PMH, which calls it a service provider. It is not strictly a repository: it holds no authoritative information about the contents nor manages their archiving, although it may complement or correct the harvested metadata. A repository and an aggregator sharing software, harvesting protocol or metadata schema eases indexing. Examples: Google Dataset Search, LA Referencia.</Literal>
    </AnnotationAssertion>

<!--  ToDo: Reify to express which API it is being harvested with? -->
    <Declaration>
        <ObjectProperty IRI="repositorio_es_cosechado_por_agregador"/>
    </Declaration>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="repositorio_es_cosechado_por_agregador"/>
        <Class IRI="repositorio_de_investigacion"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="repositorio_es_cosechado_por_agregador"/>
        <Class IRI="agregador"/>
    </ObjectPropertyRange>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio_es_cosechado_por_agregador</IRI>
        <Literal xml:lang="en">repository is harvested by aggregator</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio_es_cosechado_por_agregador</IRI>
        <Literal xml:lang="es">repositorio es cosechado por agregador</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio_es_cosechado_por_agregador</IRI>
        <Literal xml:lang="es">repositorio indexado por agregador</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>repositorio_es_cosechado_por_agregador</IRI>
        <Literal xml:lang="en">repository is indexed by aggregator</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_es_cosechado_por_agregador</IRI>
        <Literal xml:lang="es">Indica que un agregador recolecta (cosecha o indexa) los metadatos del repositorio, lo que aumenta la visibilidad de sus contenidos fuera de la institución.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_es_cosechado_por_agregador</IRI>
        <Literal xml:lang="en">States that an aggregator collects (harvests or indexes) the repository's metadata, which increases the visibility of its contents beyond the institution.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <ObjectProperty IRI="repositorio_soporta_estandar"/>
    </Declaration>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="repositorio_soporta_estandar"/>
        <Class IRI="repositorio_de_investigacion"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="repositorio_soporta_estandar"/>
        <Class IRI="estandar"/>
    </ObjectPropertyRange>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio_soporta_estandar</IRI>
        <Literal xml:lang="en">repository supports standard</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>repositorio_soporta_estandar</IRI>
        <Literal xml:lang="es">repositorio soporta estandar</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_soporta_estandar</IRI>
        <Literal xml:lang="es">Relación general entre un repositorio de investigación y un estándar que acepta, implementa o exige (esquemas de metadatos, identificadores, protocolos, etc.).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>repositorio_soporta_estandar</IRI>
        <Literal xml:lang="en">General relation between a research repository and a standard it accepts, implements or requires (metadata schemas, identifiers, protocols, etc.).</Literal>
    </AnnotationAssertion>

    <Declaration>
        <ObjectProperty IRI="consume_protocolo_de_cosecha"/>
    </Declaration>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="consume_protocolo_de_cosecha"/>
        <ObjectProperty IRI="repositorio_soporta_estandar"/>
    </SubObjectPropertyOf>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="consume_protocolo_de_cosecha"/>
        <Class IRI="repositorio_de_investigacion"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="consume_protocolo_de_cosecha"/>
        <Class IRI="protocolo_de_cosecha"/>
    </ObjectPropertyRange>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>consume_protocolo_de_cosecha</IRI>
        <Literal xml:lang="en">consumes harvesting protocol</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>consume_protocolo_de_cosecha</IRI>
        <Literal xml:lang="es">consume protocolo de cosecha</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>consume_protocolo_de_cosecha</IRI>
        <Literal xml:lang="es">Indica que el repositorio (típicamente un agregador) utiliza un protocolo de cosecha para recolectar metadatos de otras fuentes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>consume_protocolo_de_cosecha</IRI>
        <Literal xml:lang="en">States that the repository (typically an aggregator) uses a harvesting protocol to collect metadata from other sources.</Literal>
    </AnnotationAssertion>

    <Declaration>
        <ObjectProperty IRI="acepta_esquema_de_identificadores_persistentes"/>
    </Declaration>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="acepta_esquema_de_identificadores_persistentes"/>
        <ObjectProperty IRI="repositorio_soporta_estandar"/>
    </SubObjectPropertyOf>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="acepta_esquema_de_identificadores_persistentes"/>
        <Class IRI="repositorio_de_investigacion"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="acepta_esquema_de_identificadores_persistentes"/>
        <Class IRI="esquema_de_id_persistente"/>
    </ObjectPropertyRange>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>acepta_esquema_de_identificadores_persistentes</IRI>
        <Literal xml:lang="en">accepts PID schema</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>acepta_esquema_de_identificadores_persistentes</IRI>
        <Literal xml:lang="es">acepta esquema de ID persistentes</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:basado_en"/>
        <IRI>acepta_esquema_de_identificadores_persistentes</IRI>
        <Literal>https://fairsharing.gitbook.io/fairsharing/record-sections-and-fields/general-information/identifier-type</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>acepta_esquema_de_identificadores_persistentes</IRI>
        <Literal xml:lang="es">acepta tipo de identificador persistente</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>acepta_esquema_de_identificadores_persistentes</IRI>
        <Literal xml:lang="en">accepts persistent identifier type</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>acepta_esquema_de_identificadores_persistentes</IRI>
        <Literal xml:lang="es">Indica qué esquemas de identificadores persistentes (p. ej. DOI) asigna o acepta el repositorio para sus contenidos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
