    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>resultado_de_investigacion</IRI>
        <Literal xml:lang="es">producto de investigación</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>resultado_de_investigacion</IRI>
        <Literal xml:lang="en">research product</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>resultado_de_investigacion</IRI>
        <Literal xml:lang="en">research result</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>resultado_de_investigacion</IRI>
        <Literal xml:lang="es">Producto derivado de un proceso de investigación. Según la UNESCO incluye, entre otros, publicaciones científicas, datos de investigación y software. Se organiza en una taxonomía cuyas subclases principales son la colección de datos y el artículo. Es la unidad que alojan los repositorios.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>resultado_de_investigacion</IRI>
        <Literal xml:lang="en">Product derived from a research process. According to UNESCO it includes, among others, scientific publications, research data and software. It is organized in a taxonomy whose main subclasses are the dataset and the article. It is the unit hosted by repositories.</Literal>
    </AnnotationAssertion>
    <SubClassOf>
        <Class IRI="resultado_de_investigacion"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <Declaration>
        <ObjectProperty IRI="resultado_relacionado"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>resultado_relacionado</IRI>
        <Literal xml:lang="es">resultado relacionado</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>resultado_relacionado</IRI>
        <Literal xml:lang="en">related output</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>resultado_relacionado</IRI>
        <Literal xml:lang="es">Relaciona dos resultados de investigación vinculados entre sí, por ejemplo una colección de datos y el artículo que la utiliza.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>resultado_relacionado</IRI>
        <Literal xml:lang="en">Links two related research outputs, for example a dataset and the article that uses it.</Literal>
    </AnnotationAssertion>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="resultado_relacionado"/>
