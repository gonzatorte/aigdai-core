    <Declaration>
        <Class IRI="organizacion"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="organizacion"/>
        <Class abbreviatedIRI="owl:Thing"/>
    </SubClassOf>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>organizacion</IRI>
        <Literal xml:lang="es">organización</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>organizacion</IRI>
        <Literal xml:lang="en">organization</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>organizacion</IRI>
        <Literal xml:lang="es">institución</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>organizacion</IRI>
        <Literal xml:lang="en">institution</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>organizacion</IRI>
        <Literal xml:lang="en">organisation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>organizacion</IRI>
        <Literal xml:lang="es">Entidad (universidad, agencia de financiación, instituto, empresa, gobierno, etc.) que participa en el proceso de investigación y se relaciona con repositorios desde distintos roles: administrativo, técnico, de financiamiento o patrocinio. Su definición se basa en ROR, que registra organizaciones citadas por los investigadores como afiliación o financiadoras. Las organizaciones forman jerarquías (dependencia), relaciones de sucesión y otras relaciones, y pueden establecer políticas propias sobre la publicación de datos.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>organizacion</IRI>
        <Literal xml:lang="en">Entity (university, funding agency, institute, company, government, etc.) that takes part in the research process and relates to repositories through different roles: administrative, technical, funding or sponsorship. Its definition is based on ROR, which registers organizations cited by researchers as affiliation or funders. Organizations form hierarchies (dependency), succession and other relations, and may set their own policies on data publication.</Literal>
    </AnnotationAssertion>
    <Declaration>
        <ObjectProperty IRI="es_organizacion_antecesora"/>
    </Declaration>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>es_organizacion_antecesora</IRI>
        <Literal xml:lang="es">es organización antecesora</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>es_organizacion_antecesora</IRI>
        <Literal xml:lang="en">is ancestor organization</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>es_organizacion_antecesora</IRI>
        <Literal xml:lang="es">Relación jerárquica entre organizaciones: indica que una organización está por encima de otra en la estructura de dependencia, directa o indirectamente.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>es_organizacion_antecesora</IRI>
        <Literal xml:lang="en">Hierarchical relation between organizations: states that an organization is above another in the dependency structure, directly or indirectly.</Literal>
    </AnnotationAssertion>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="es_organizacion_antecesora"/>
        <Class IRI="organizacion"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
