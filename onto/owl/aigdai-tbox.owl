        <IRI>certificacion</IRI>
        <Literal xml:lang="en">seal</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>certificacion</IRI>
        <Literal xml:lang="en">accreditation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>certificacion</IRI>
        <Literal xml:lang="es">Criterio de calidad definido por una organización certificadora como un conjunto de requisitos detallados y verificables que un repositorio debe cumplir para ser reconocido como confiable. Aplica los principios generales (FAIR, TRUST) a un contexto concreto con mayor nivel de detalle. Ejemplos: CoreTrustSeal, ISO 16363. No existe una fuente autoritativa y centralizada para verificar su vigencia.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>certificacion</IRI>
        <Literal xml:lang="en">Quality criterion defined by a certifying organization as a set of detailed, verifiable requirements a repository must meet to be recognized as trustworthy. It applies general principles (FAIR, TRUST) to a concrete context with a higher level of detail. Examples: CoreTrustSeal, ISO 16363. There is no authoritative, centralized source to verify its validity.</Literal>
    </AnnotationAssertion>

