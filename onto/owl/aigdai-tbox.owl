        <IRI>perfila_estandar</IRI>
        <Literal xml:lang="es">Indica que un estándar es un perfil de aplicación de otro: lo restringe o adapta a un contexto o comunidad particular (p. ej. DCAT-AP respecto de DCAT).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
