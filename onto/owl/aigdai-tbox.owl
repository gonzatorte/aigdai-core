        <Literal xml:lang="en">cite export format</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:nombre_usual"/>
        <IRI>formato_de_exportacion_de_citas</IRI>
        <Literal xml:lang="es">formato de exportación de citas</Literal>
