        <IRI>protocolo_de_cosecha</IRI>
        <Literal xml:lang="en">metadata harvesting protocol</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>protocolo_de_cosecha</IRI>
        <Literal xml:lang="es">Estándar que define cómo un sistema expone sus metadatos para que otros los recolecten de forma automática. Es el mecanismo por el que los agregadores indexan repositorios. Ejemplo: OAI-PMH.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>protocolo_de_cosecha</IRI>
        <Literal xml:lang="en">Standard defining how a system exposes its metadata so that others can collect it automatically. It is the mechanism through which aggregators index repositories. Example: OAI-PMH.</Literal>
    </AnnotationAssertion>

