<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://base.owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="http://base.owl"
     versionIRI="http://base.owl/v0.1">
    <Prefix name="" IRI="http://base.owl#"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>

    <Declaration>
        <AnnotationProperty IRI="nombre_usual"/>
    </Declaration>
    <Declaration>
        <AnnotationProperty IRI="sinonimo"/>
    </Declaration>
    <Declaration>
        <AnnotationProperty IRI="descripcion"/>
    </Declaration>
    <Declaration>
        <AnnotationProperty IRI="basado_en"/>
    </Declaration>
</Ontology>
