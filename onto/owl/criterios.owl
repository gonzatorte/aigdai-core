    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>considera_criterio</IRI>
        <Literal xml:lang="es">Indica que un criterio de calidad tiene en cuenta o se alinea con otro, sin que necesariamente lo implique (p. ej. una certificación que considera los principios FAIR).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>considera_criterio</IRI>
        <Literal xml:lang="en">States that a quality criterion takes into account or is aligned with another, without necessarily implying it (e.g. a certification that considers the FAIR principles).</Literal>
    </AnnotationAssertion>

