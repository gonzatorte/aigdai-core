    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>criterio_de_calidad</IRI>
        <Literal xml:lang="en">quality principle</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:sinonimo"/>
        <IRI>criterio_de_calidad</IRI>
