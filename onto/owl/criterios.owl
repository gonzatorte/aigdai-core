    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>grupo_de_criterio</IRI>
        <Literal xml:lang="es">Categoría que agrupa criterios de calidad afines dentro de un mismo marco (p. ej. la dimensión de transparencia de TRUST).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>grupo_de_criterio</IRI>
        <Literal xml:lang="en">Category grouping related quality criteria within the same framework (e.g. the TRUST transparency dimension).</Literal>
    </AnnotationAssertion>
