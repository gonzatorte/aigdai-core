    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>extiende_de_criterio</IRI>
        <Literal xml:lang="es">Indica que un criterio de calidad es un componente o especialización más concreta de otro más general (p. ej. una métrica de TRUST respecto de TRUST).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="base:descripcion"/>
        <IRI>extiende_de_criterio</IRI>
        <Literal xml:lang="en">States that a quality criterion is a more concrete component or specialization of a more general one (e.g. a TRUST metric with respect to TRUST).</Literal>
    </AnnotationAssertion>

