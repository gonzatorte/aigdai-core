        <skos:prefLabel xml:lang="ru">геопространственные данные</skos:prefLabel>
        <skos:prefLabel xml:lang="ar">بيانات جغرافية</skos:prefLabel>
        <skos:prefLabel xml:lang="ja">地理空間データ</skos:prefLabel>
        <skos:prefLabel xml:lang="zh">地理空间数据</skos:prefLabel>
