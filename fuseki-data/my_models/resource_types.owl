    <!-- http://purl.org/coar/resource_type/CQMR-7K63 -->

    <NamedIndividual rdf:about="http://purl.org/coar/resource_type/CQMR-7K63">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#coar_resource_type"/>
