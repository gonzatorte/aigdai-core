    <!-- http://purl.org/coar/resource_type/A8F1-NPV9 -->

    <NamedIndividual rdf:about="http://purl.org/coar/resource_type/A8F1-NPV9">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#coar_resource_type"/>
        <skos:broadMatch rdf:resource="http://purl.org/datacite/v4.4/Dataset"/>
        <skos:broaderTransitive rdf:resource="http://purl.org/coar/resource_type/c_ddb1"/>
        <skos:definition xml:lang="en">Genomic data refers to the genome and DNA data of an organism. They are used in bioinformatics for collecting, storing and processing the genomes of living things. Genomic data is a more extensive term than sequencing data. However genomic data mostly come from sequencing techniques. It may include non-sequencing data such as data from microarrays, data from real-time PCR panels and data from pharmacogenomics studies. [Source: Adapted from https://www.techopedia.com/definition/31247/genomic-data]</skos:definition>
        <skos:exactMatch rdf:resource="http://www.ebi.ac.uk/efo/EFO_0004600"/>
        <skos:inScheme rdf:resource="http://purl.org/coar/resource_type/scheme"/>
        <skos:prefLabel xml:lang="de">Genomdaten</skos:prefLabel>
        <skos:prefLabel xml:lang="ca">dades genòmiques</skos:prefLabel>
        <skos:prefLabel xml:lang="pt">dados genómicos</skos:prefLabel>
        <skos:prefLabel xml:lang="ro">date genomice</skos:prefLabel>
        <skos:prefLabel xml:lang="it">dati genomici</skos:prefLabel>
        <skos:prefLabel xml:lang="es">datos genómicos</skos:prefLabel>
        <skos:prefLabel xml:lang="gl">datos xenómicos</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">donnée génomique</skos:prefLabel>
        <skos:prefLabel xml:lang="en">genomic data</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">genomidata</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">genomik veri</skos:prefLabel>
        <skos:prefLabel xml:lang="hu">genomikai adatok</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">genomische data</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">genomiska data</skos:prefLabel>
        <skos:prefLabel xml:lang="da">genomiske data</skos:prefLabel>
        <skos:prefLabel xml:lang="sr">genomski podaci</skos:prefLabel>
        <skos:prefLabel xml:lang="sl">genomski podatki</skos:prefLabel>
        <skos:prefLabel xml:lang="el">γονιδιωματικά δεδομένα</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">геномные данные</skos:prefLabel>
