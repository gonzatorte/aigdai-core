    <!-- http://purl.org/coar/resource_type/63NG-B465 -->

    <NamedIndividual rdf:about="http://purl.org/coar/resource_type/63NG-B465">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#coar_resource_type"/>
