        <skos:altLabel xml:lang="sl">sodni spisi</skos:altLabel>
        <skos:broadMatch rdf:resource="http://purl.bioontology.org/ontology/MESH/D016418"/>
        <skos:broadMatch rdf:resource="https://sparontologies.github.io/fabio/current/fabio.html#d4e3790"/>
