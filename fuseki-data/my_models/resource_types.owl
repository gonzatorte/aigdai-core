    <!-- http://purl.org/coar/resource_type/AM6W-6QAW -->

    <NamedIndividual rdf:about="http://purl.org/coar/resource_type/AM6W-6QAW">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#coar_resource_type"/>
