        <skos:prefLabel xml:lang="tr">toplanmış veri</skos:prefLabel>
        <skos:prefLabel xml:lang="el">συγκεντρωτικά δεδομένα</skos:prefLabel>
        <skos:prefLabel xml:lang="sr-cyrl">агрегирани подаци</skos:prefLabel>
        <skos:prefLabel xml:lang="ru">агрегированные данные</skos:prefLabel>
