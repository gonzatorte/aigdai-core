    <!-- http://purl.org/coar/resource_type/MW8G-3CR8 -->

    <NamedIndividual rdf:about="http://purl.org/coar/resource_type/MW8G-3CR8">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#coar_resource_type"/>
        <skos:altLabel xml:lang="fr">brevet logiciel</skos:altLabel>
        <skos:altLabel xml:lang="nl">octrooi op software</skos:altLabel>
        <skos:altLabel xml:lang="sr">softverski patent</skos:altLabel>
        <skos:altLabel xml:lang="sr-cyrl">софтверски патент</skos:altLabel>
        <skos:altLabel xml:lang="zh">软件专利</skos:altLabel>
        <skos:broadMatch rdf:resource="http://purl.org/datacite/v4.4/Software"/>
        <skos:broadMatch rdf:resource="https://sparontologies.github.io/fabio/current/fabio.html#d4e4551"/>
        <skos:broaderTransitive rdf:resource="http://purl.org/coar/resource_type/c_15cd"/>
        <skos:definition xml:lang="en">In order to obtain a patent, a software invention must not fall under other non-patentable subject matter (for example, abstract ideas or mathematical theories) and has to fulfill the other substantive patentability criteria (for example, novelty, inventive step [non-obviousness] and industrial applicability [usefulness]). [Source: https://www.wipo.int/patents/en/faq_patents.html]</skos:definition>
        <skos:inScheme rdf:resource="http://purl.org/coar/resource_type/scheme"/>
        <skos:prefLabel xml:lang="de">Softwarepatent</skos:prefLabel>
