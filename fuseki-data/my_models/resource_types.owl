        <skos:prefLabel xml:lang="da">geospatiale data</skos:prefLabel>
        <skos:prefLabel xml:lang="nl">geospatiale gegevens</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">paikkatieto</skos:prefLabel>
        <skos:prefLabel xml:lang="hu">térinformációs adatok</skos:prefLabel>
