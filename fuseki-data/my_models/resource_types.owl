    <!-- http://purl.org/coar/resource_type/JBNF-DYAD -->

    <NamedIndividual rdf:about="http://purl.org/coar/resource_type/JBNF-DYAD">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#coar_resource_type"/>
