        <skos:narrowMatch rdf:resource="https://vocabs.acdh.oeaw.ac.at/archecategory/model/controlledVocabulary"/>
        <skos:prefLabel xml:lang="de">Wissensorganisationssystem</skos:prefLabel>
        <skos:prefLabel xml:lang="tr">bilgi organizasyon sistemi</skos:prefLabel>
