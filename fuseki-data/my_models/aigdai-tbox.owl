        <rdfs:range rdf:resource="http://aigdai-tbox.owl#esquema_de_id_de_autor"/>
        <base:nombre_usual xml:lang="en">accepts author ID schema</base:nombre_usual>
        <base:nombre_usual xml:lang="es">acepta esquema de ID autor</base:nombre_usual>
    </owl:ObjectProperty>
    


