     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:base="http://base.owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://aigdai-tbox.owl">
        <owl:versionIRI rdf:resource="http://aigdai-tbox.owl/v0.1"/>
        <owl:imports rdf:resource="http://base.owl/v0.1"/>
        <owl:imports rdf:resource="http://criterios.owl/v0.1"/>
        <owl:imports rdf:resource="http://lenguajes.owl/v0.1"/>
