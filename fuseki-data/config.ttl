## Fuseki Server configuration file.

@prefix :       <#> .
@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ja:     <http://jena.hpl.hp.com/2005/11/Assembler#> .
@prefix tdb2:   <http://jena.apache.org/2016/tdb#> .
@prefix tdb:    <http://jena.hpl.hp.com/2008/tdb#> .

[] rdf:type fuseki:Server ;
   # Example::
   # Server-wide query timeout.   
   # 
   # Timeout - server-wide default: milliseconds.
   # Format 1: "1000" -- 1 second timeout
   # Format 2: "10000,60000" -- 10s timeout to first result, 
   #                            then 60s timeout for the rest of query.
   #
   # See javadoc for ARQ.queryTimeout for details.
   # This can also be set on a per dataset basis in the dataset assembler.
   #
   # ja:context [ ja:cxtName "arq:queryTimeout" ;  ja:cxtValue "30000" ] ;

   # Add any custom classes you want to load.
   # Must have a "public static void init()" method.
   # ja:loadClass "your.code.Class" ;   

   # End triples.
.

:tbox_graph
    rdfs:label "tbox" ;
    a ja:InfModel ;
    ja:baseModel :data_graph ;
#    ja:content [ja:externalContent <file://fuseki/model.owl> ] ;
#    ja:content [ja:externalContent <file://fuseki/my_models/aigdai-tbox.owl> ] ;
#    ja:content [ja:externalContent <file://fuseki/my_models/base.owl> ] ;
#    ja:content [ja:externalContent <file://fuseki/my_models/criterios.owl> ] ;
#    ja:content [ja:externalContent <file://fuseki/my_models/lenguajes.owl> ] ;
#    ja:content [ja:externalContent <file://fuseki/my_models/resource_types.owl> ] ;

    # value from https://github.com/apache/jena/blob/main/jena-core/src/main/java/org/apache/jena/reasoner/rulesys/OWLFBRuleReasonerFactory.java#L49C39-L49C84
    ja:reasoner [ja:reasonerURL <http://jena.hpl.hp.com/2003/OWLFBRuleReasoner>] ;
    #Enable Jena Rules-based reasoner and we point the location of myrules.rules file
#    ja:reasoner [
#        ja:reasonerURL <http://jena.hpl.hp.com/2003/GenericRuleReasoner> ;
#        ja:rulesFrom <file://fuseki/myrules.rules> ;
#    ] ;
.

:data_dataset
    rdf:type       tdb2:DatasetTDB2;
    tdb2:location  "/fuseki/databases/with_data" ;
#    tdb2:unionDefaultGraph true ;
.

:data_graph
    a tdb2:GraphTDB ;
    tdb2:dataset :data_dataset ;
#    tdb2:graphName <urn:x-arq:UnionGraph> ;
.

#:all_graph
#    a ja:UnionModel ;
#    ja:rootModel :tbox_graph ;
#    ja:subModel :data_graph ;
#.

#:schema_dataset
#    rdf:type 	ja:RDFDataset ;
#    ja:defaultGraph :tbox_graph ;
#    rdfs:label "schemadataset" ;
#.

:all_dataset
    rdf:type 	ja:RDFDataset ;
#    ja:namedGraph
#        [
#            ja:graphName      <http://example.org/data> ;
#            ja:graph          :data_graph
#        ] ;
    ja:defaultGraph :tbox_graph ;
#    ja:defaultGraph :data_graph ;
##    ja:graph :tbox_graph ;
#    ja:namedGraph
#        [
#            ja:graphName      <http://example.org/tbox> ;
#            ja:graph          :tbox_graph
#        ] ;
#    ja:defaultGraph :tbox_graph ;
    rdfs:label "alldataset" ;
.

:service1	a                         fuseki:Service ;
    fuseki:dataset                    :all_dataset ;
    fuseki:name                       "allservice" ;
    fuseki:serviceQuery               "query" , "sparql" ;
    fuseki:serviceReadGraphStore      "get" ;
    fuseki:serviceReadWriteGraphStore "data" ;
    fuseki:serviceUpdate              "update" ;
    fuseki:serviceUpload              "upload" ;
.

